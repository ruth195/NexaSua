# MONGODB_URI: MongoDB Atlas connection string (e.g., mongodb+srv://user:pass@cluster.mongodb.net/nexasua?retryWrites=true&w=majority)
MONGODB_URI=

# SUPER_ADMIN_EMAIL & SUPER_ADMIN_PASSWORD: NexaFlow Super Admin login credentials secret pair.
# Change these secrets anytime in AI Studio Settings -> Secrets to update your Super Admin email or password.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ADMIN_EMAIL & ADMIN_PASSWORD: School Admin login credentials secret pair.
# Once set in Secrets, entering them on /login automatically authenticates and opens the School Admin workspace.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SUPER_ADMIN_SETUP_KEY: Optional extra setup key for first-time Super Admin bootstrap when email/password secrets are not set.
SUPER_ADMIN_SETUP_KEY=

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: Google OAuth 2.0 credentials for School Portal Sign in with Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PAYSTACK_SECRET_KEY & PAYSTACK_PUBLIC_KEY: NexaFlow Technologies Paystack credentials for school SaaS subscriptions
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# SMTP Transactional Email Configuration (Optional - leave blank if unconfigured)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS Provider Configuration (Optional - e.g. Hubtel / Arkesel HTTP endpoint for Ghana)
SMS_PROVIDER_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# GEMINI_API_KEY: Optional server-side Gemini AI key for non-student-PII draft assistance
GEMINI_API_KEY=

# APP_URL: Public base URL of the deployed NexaSua instance
APP_URL=
